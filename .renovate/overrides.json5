{
  // The Helmfile depName override and the factory.talos.dev package
  // rename are now covered by github>home-operations/renovate-presets
  // (overrides/helmfile.json5 and managers/talosFactory.json5 respectively -
  // the latter is a real improvement over the old rename, since it tracks
  // Talos versions against factory.talos.dev's own version list instead of
  // proxying through the installer image's docker tags). Both repo-specific
  // version blocks below aren't covered by anything upstream and stay here.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Block OrcaSlicer 2.3.2 — linuxserver ls7 build missing libmspack0",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/linuxserver/orcaslicer"],
      allowedVersions: "!/^2\\.3\\.2/",
    },
    {
      description: "Block multus chart 1.3.x — bjw-s common v5 defaults automountServiceAccountToken=false; chart doesn't expose override; breaks multus API server access",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/bjw-s-labs/helm/multus"],
      allowedVersions: "!/^1\\.3\\./",
    },
    {
      // 2026-08-03: the managers/cnpg.json5 custom manager we picked up from
      // the shared preset started tracking Cluster.spec.imageName, which
      // proposed a single PR bumping all 13 CNPG-backed databases from PG
      // 17 to 18 in one shot - a real major-version upgrade (PG data files
      // aren't binary-compatible across majors; needs a planned per-database
      // migration via CNPG's online logical-replication upgrade or a
      // backup/restore, not a routine image swap). Hold at 17.x until
      // there's an actual upgrade plan; patch/minor within 17.x still flow
      // through normally.
      description: "Hold CloudNativePG PostgreSQL image at 17.x pending a planned major-version migration",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      allowedVersions: "<18.0.0",
    },
    {
      // home-operations/renovate-presets#7.0.0 added a customManager that
      // scans every .yaml file for oci://...:... substrings (Flux
      // OCIRepository/Helm OCI charts) - too broad, it also matches the
      // dynamic `flux push/tag artifact "oci://ghcr.io/${REPO_OWNER_LC}/
      // terraform/$(basename "${MATRIX_PROJECT}"):..."` shell commands in
      // .github/workflows/publish-terraform-oci.yaml, producing a phantom
      // dependency (literal unexpanded ${...}/$(...) syntax as the
      // packageName) that can never resolve a docker token. That poisoned
      // several grouped branch updates (pin-dependencies, flux-operator,
      // kubernetes, 1password-connect all failed with "Error updating
      // branch: update failure" in the same run this was diagnosed from).
      // A real OCI reference can never contain a literal $, so this is a
      // safe, general exclusion rather than a one-off pin to that file.
      description: "Ignore phantom docker deps from unexpanded shell variables/command substitution matched by the oci:// URI custom manager",
      matchDatasources: ["docker"],
      matchPackageNames: ["/[$]/"],
      enabled: false,
    },
    {
      // The shared preset's "annotated" regex custom manager (matches
      // `# renovate: datasource=... depName=...` comments) has no
      // currentDigest capture group or autoReplaceStringTemplate, so it can
      // update an EXISTING digest but can never write a first-time one -
      // docker:pinDigests still tries (it applies by matchDatasources, not
      // by manager), computes a real new digest, then fails to find
      // anywhere to write it ("Digest is not updated" / foundValue:
      // undefined), which fails the whole grouped `kubernetes` branch this
      // dependency sits in. tuppr's KubernetesUpgrade.spec.kubernetes.version
      // is a bare CRD version field, not an image ref, so it can't be
      // reshaped into a literal `repo:tag` the built-in manager would
      // handle instead (unlike the sibling cloudnative-pg/barman-cloud
      // SIDECAR_IMAGE case, which *was* fixed that way). The real
      // ghcr.io/siderolabs/kubelet image (talos/machineconfig.yaml.j2)
      // still gets digest-pinned normally via the built-in kubernetes
      // manager - this only disables the redundant, broken annotated-comment
      // attempt on this one CRD field.
      description: "Don't attempt digest-pinning on tuppr's KubernetesUpgrade version field - the annotated regex manager can't write a first-time digest here",
      matchFileNames: ["kubernetes/apps/system-upgrade/tuppr/upgrades/kubernetesupgrade.yaml"],
      matchDatasources: ["docker"],
      pinDigests: false,
    },
  ],
}
