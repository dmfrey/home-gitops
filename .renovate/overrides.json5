{
  // The Helmfile depName override and the factory.talos.dev package
  // rename are now covered by github>home-operations/renovate-presets
  // (overrides/helmfile.json5 and managers/talosFactory.json5 respectively -
  // the latter is a real improvement over the old rename, since it tracks
  // Talos versions against factory.talos.dev's own version list instead of
  // proxying through the installer image's docker tags). Both repo-specific
  // version blocks below aren't covered by anything upstream and stay here.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Block OrcaSlicer 2.3.2 — linuxserver ls7 build missing libmspack0",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/linuxserver/orcaslicer"],
      allowedVersions: "!/^2\\.3\\.2/",
    },
    {
      description: "Block multus chart 1.3.x — bjw-s common v5 defaults automountServiceAccountToken=false; chart doesn't expose override; breaks multus API server access",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/bjw-s-labs/helm/multus"],
      allowedVersions: "!/^1\\.3\\./",
    },
    {
      // 2026-08-03: the managers/cnpg.json5 custom manager we picked up from
      // the shared preset started tracking Cluster.spec.imageName, which
      // proposed a single PR bumping all 13 CNPG-backed databases from PG
      // 17 to 18 in one shot - a real major-version upgrade (PG data files
      // aren't binary-compatible across majors; needs a planned per-database
      // migration via CNPG's online logical-replication upgrade or a
      // backup/restore, not a routine image swap). Hold at 17.x until
      // there's an actual upgrade plan; patch/minor within 17.x still flow
      // through normally.
      description: "Hold CloudNativePG PostgreSQL image at 17.x pending a planned major-version migration",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      allowedVersions: "<18.0.0",
    },
    {
      // 2026-08-11: PR #4866 proposed "17-1.1.1 -> 18-1.1.1" for
      // spring-notes-db's cloudnative-vectorchord operand image - same
      // PG17->PG18 data-directory major-upgrade risk as the cnpg/postgresql
      // hold above, just via a different image family the matchPackageNames
      // there doesn't cover, so Renovate proposed it anyway. This image's
      // tag format is "<pg-major>-<vectorchord-version>" (e.g. "17-1.1.1"),
      // not a plain semver, so the leading "17-" component IS the PG major -
      // hold it the same way until there's an actual per-database migration
      // plan. Also covers self-hosted/immich/immich-db (tag "17-0.4.3"),
      // which will hit the identical proposed bump later.
      description: "Hold cloudnative-vectorchord image at PG 17.x (tag prefix) pending a planned major-version migration - same reasoning as the cnpg/postgresql hold above",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/tensorchord/cloudnative-vectorchord"],
      allowedVersions: "/^17-/",
    },
    {
      // home-operations/renovate-presets#7.0.0 added a customManager that
      // scans every .yaml file for oci://...:... substrings (Flux
      // OCIRepository/Helm OCI charts) - too broad, it also matches the
      // dynamic `flux push/tag artifact "oci://ghcr.io/${REPO_OWNER_LC}/
      // terraform/$(basename "${MATRIX_PROJECT}"):..."` shell commands in
      // .github/workflows/publish-terraform-oci.yaml, producing a phantom
      // dependency (literal unexpanded ${...}/$(...) syntax as the
      // packageName) that can never resolve a docker token. That poisoned
      // several grouped branch updates (pin-dependencies, flux-operator,
      // kubernetes, 1password-connect all failed with "Error updating
      // branch: update failure" in the same run this was diagnosed from).
      // A real OCI reference can never contain a literal $, so this is a
      // safe, general exclusion rather than a one-off pin to that file.
      description: "Ignore phantom docker deps from unexpanded shell variables/command substitution matched by the oci:// URI custom manager",
      matchDatasources: ["docker"],
      matchPackageNames: ["/[$]/"],
      enabled: false,
    },
    {
      // 2026-08-08: confirmed the `pinDigest` update type (Renovate's name
      // for "add a digest, nothing else about the value changes") is
      // structurally broken across this repo's dominant dependency shape,
      // not just the cloudnative-pg/tuppr cases found earlier the same day
      // (see those fixes' commit messages). Renovate's own extraction for
      // Flux OCIRepository refs (manager: "flux") and CRD scalar fields
      // (manager: "regex") is pattern/regex-based under the hood, same
      // long-standing, still-open, low-priority upstream limitation as
      // renovatebot/renovate#24942 and #10993 (open since 2025, no fix
      // planned): these extractors can update an EXISTING digest but can't
      // write a first-time one onto a bare tag. Every OCIRepository in this
      // repo hit this identically in the same "pin-dependencies" batch
      // ("Digest is not updated" / foundValue: undefined for ~60 files, one
      // grouped branch, confirmed via raw job log) - this rule supersedes
      // the narrower tuppr-specific pinDigests:false override that
      // preceded it, now covered by this broader one.
      //
      // Ordinary version-bump PRs are a different, working code path -
      // proven repeatedly the same day this was diagnosed (spring-notes,
      // rabbitmq, unpoller, ollama, external-secrets all landed a fresh
      // `tag: vX@sha256:...` correctly as part of a real version change).
      // Disabling only the standalone backfill-onto-unchanged-version type
      // keeps that working path fully intact; it just stops Renovate from
      // repeatedly proposing (and failing) a bulk backfill of the ~144
      // pre-existing un-pinned images that can never succeed as constructed.
      // Digests for those will arrive naturally, one at a time, the next
      // time each dependency's version actually bumps.
      description: "Don't attempt standalone digest backfills (pinDigest) - structurally broken for this repo's flux/regex-extracted dependencies; digests still land normally as part of real version bumps",
      matchUpdateTypes: ["pinDigest"],
      enabled: false,
    },
    {
      // 2026-08-27: PR #4995 bumped kubernetes/upgrades/kubernetesupgrade.yaml
      // straight to v1.37.0. tuppr picked it up and ran
      // `talosctl upgrade-k8s --to=v1.37.0`, which failed permanently
      // ("unsupported upgrade path 1.36->1.37") on the current Talos/talosctl
      // 1.13.9 before touching any node - cluster stayed on v1.36.4 the
      // whole time, no partial-upgrade damage. Hold until Talos/talosctl
      // actually supports the 1.36->1.37 path; re-verify with
      // `talosctl upgrade-k8s --to=v1.37.0 --dry-run` before lifting this.
      description: "Hold Kubernetes upgrade target below v1.37.0 until Talos/talosctl supports the 1.36->1.37 upgrade path",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/siderolabs/kubelet"],
      allowedVersions: "<1.37.0",
    },
    {
      // 2026-08-28/29: PR #5001 bumped unpackerr's `unstable` digest to
      // 4e883aef... - that build's /unpackerr binary fails to exec
      // entirely (exec: "/unpackerr": permission denied, reproduced both
      // as uid 1000 and as the image's own default user via a throwaway
      // pod, so it's the binary itself, not a non-root permission issue).
      // Helm's own remediation auto-rolled the release back after 2 failed
      // upgrade attempts, so the app stayed up throughout - but Flux kept
      // re-flagging the Kustomization unhealthy on every reconcile since.
      // Checked the tag's newest digest as of 2026-08-29 (91382f89...) too
      // - still broken, so this is an ongoing bad patch in the unstable
      // channel's build pipeline, not a one-off. No semver here since it's
      // a floating/digest-only tag, hence enabled:false rather than
      // allowedVersions. Re-enable once a fresh unstable digest is
      // confirmed to actually exec (same throwaway-pod check), or consider
      // switching off the unstable channel entirely.
      description: "Hold unpackerr's unstable digest - current and newest-checked builds both ship a non-executable binary",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/golift/unpackerr"],
      enabled: false,
    },
  ],
}
