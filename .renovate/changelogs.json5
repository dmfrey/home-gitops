{
  // 1Password Connect and Cloudflared changelog URLs are now covered by
  // github>home-operations/renovate-presets//overrides/changelogs.json5.
  // Spegel isn't in that bundle, so it stays here.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Changelog URL for Spegel",
      matchPackageNames: ["/spegel/"],
      changelogUrl: "https://github.com/spegel-org/spegel/blob/main/CHANGELOG.md",
    },
  ],
}
