{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    // Bundles config:recommended, docker:enableMajor,
    // helpers:pinGitHubActionDigestsToSemver, :automergeBranch,
    // :dependencyDashboard, :disableRateLimiting, the dependency dashboard
    // title, CNPG/OCI/annotated/talosFactory/grafanaDashboards custom
    // managers, and semantic-commit policy - see
    // https://github.com/home-operations/renovate-presets
    'github>home-operations/renovate-presets#4.0.0',
    'docker:pinDigests',
    'github>dmfrey/home-gitops//.renovate/autoMerge.json5',
    'github>dmfrey/home-gitops//.renovate/changelogs.json5',
    'github>dmfrey/home-gitops//.renovate/grafanaDashboards.json5',
    'github>dmfrey/home-gitops//.renovate/groups.json5',
    'github>dmfrey/home-gitops//.renovate/labels.json5',
    'github>dmfrey/home-gitops//.renovate/overrides.json5',
    ':timezone(America/New_York)',
  ],
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  ignorePaths: [
    '**/resources/**',
    '**/nzbget/extension/**',
    'archive/**',
  ],
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  'helm-values': {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/", "!/talos/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
}
