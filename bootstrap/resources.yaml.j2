---
apiVersion: v1
kind: Secret
metadata:
  name: onepassword-connect-credentials-secret
  namespace: external-secrets
stringData:
  # OP_CREDENTIALS_JSON stores the raw decoded credentials JSON directly
  # (not base64) - the official ghcr.io/1password/connect chart mounts this
  # key as a file expecting real JSON. See CLAUDE.md's 1Password Connect
  # section for why this matters.
  1password-credentials.json: op://kubernetes/1password/OP_CREDENTIALS_JSON
---
apiVersion: v1
kind: Secret
metadata:
  name: onepassword-connect-vault-secret
  namespace: external-secrets
stringData:
  OP_CONNECT_TOKEN: op://kubernetes/1password/OP_CONNECT_TOKEN
---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-tunnel-id-secret
  namespace: network
stringData:
  CLOUDFLARE_TUNNEL_ID: op://kubernetes/cloudflare/CLOUDFLARE_TUNNEL_ID
