---
customization:
  extraKernelArgs:
    - -init_on_alloc                      # Less security, faster puter
    - -init_on_free                       # Less security, faster puter
    - -selinux                            # Less security, faster puter

    # --- Performance & Security Tradeoffs ---
    - mitigations=off                     # Disables CPU speculative execution mitigations
    - apparmor=0                          # Disable AppArmor LSM
    - security=none                       # Disable default security profile
    - init_on_alloc=0                     # Disable zeroing memory on allocation
    - init_on_free=0                      # Disable zeroing memory on free
    - talos.auditd.disabled=1             # Disable Linux audit daemon

    # --- Hardware Enablement & Virtualization ---
    - intel_iommu=on                      # Enable the IOMMU
    - iommu=pt                            # Use passthrough mode for IOMMU
    - i915.enable_guc=3                   # Enable GuC/HuC for 13th-gen Intel iGPU
    - sysctl.kernel.kexec_load_disabled=1 # Security hardening
    # 2026-07-29: confirmed via `talosctl get links` that the PELADN Link S-3
    # eGPU dock exposes a USB-attached Realtek NIC (driver r8152, MAC 00:e0:4c:*)
    # alongside GPU passthrough - currently down/no-link but a real device, not
    # just a theoretical risk. Blacklisting the driver entirely (not just leaving
    # it unaliased) means it never appears as a network device at all, regardless
    # of cable state. r8152 isn't used by anything else in this cluster, so this
    # is harmless on k8s-0/k8s-1 too even though only k8s-2 has the dock.
    - module_blacklist=r8152
    # - intel_pstate.energy_performance_preference=performance # Prioritize performance for Intel CPU

    # --- System Configuration ---
    # 2026-07-29: net.ifnames=0 (classic eth0/eth1 naming, boot-order dependent)
    # removed - onboard NIC is now matched via LinkAliasConfig by driver+MAC
    # (talos/machineconfig.yaml.j2), which is name-independent either way. Removing
    # this establishes predictable (systemd-style) naming as the actual baseline
    # before the next eGPU dock attempt, so a dock-attached NIC gets its own
    # unique, non-colliding predictable name instead of racing for "eth0".
    - tsc=reliable                        # i7-13620H has invariant TSC; skip kernel verification overhead
    # pcie_ports=native, pcie_aspm=off, pcie_port_pm=off remain REMOVED (2026-07-22):
    # added during the RTX 5070/AG02 link-stability investigation, never conclusively
    # fixed anything (that card's actual problem was an unrelated NVIDIA Blackwell
    # GSP-firmware bug, see project_egpu_k8s2 memory), and k8s-2 had 3+ unexplained
    # hard reboots with no eGPU connected while running these (globally disabling
    # PCIe ASPM/power-management, not just the Thunderbolt slot); k8s-0/k8s-1 never
    # had these args and never showed the same instability.
    # RE-ADDED 2026-07-25: thunderbolt.host_reset=0 only (not the 3 args above), as
    # an isolated test. RTX 3090 in the eGPU dock now shows a real, reproducible
    # link problem independent of authorization/drivers: PCIe hotplug command 0x1038
    # times out on the dock's own downstream switch port ~12-20s after a clean
    # connect + full enumeration, on both TB4 root ports, surviving a cable reseat.
    # This is the "genuine link problems" evidence the above removal called for.
    # 2026-07-28: commented out for a test with the PELADN Link S-3 (Intel Barlow Ridge
    # TB5 controller) - the AG02/ASM2464 hotplug timeout this was targeting is specific
    # to that dock's bridge chip, not present with the Link S-3, so this may not be
    # needed anymore. Re-enable if the Link S-3 shows the same link problems.
    # - thunderbolt.host_reset=0             # Preserve BIOS PCIe/BAR config on Thunderbolt hotplug reset; testing in isolation against the RTX 3090's hotplug command timeout
    # - pci=realloc,hpmmiosize=64M,hpmmioprefsize=8G # REVERTED 2026-07-19: caused a crash on AG02 reconnect severe enough that sd-boot auto-rolled-back the node to the previous UKI entry. Do not re-add without further investigation.
    # 2026-07-25: thunderbolt.host_reset=0 alone did not fix the hotplug command 0x1038
    # timeout (still reproduces, ~9-20s after link-up, regardless of dock-before-node vs
    # hotplug-after-boot sequencing - both tested). Also tried, same day, all REVERTED:
    #   - pci=realloc,assign-busses (stacked on host_reset=0): inconsistent - one retest
    #     reached full GPU enumeration + BAR assignment then hit the same hotplug 0x1038
    #     timeout ~9-20s later; another retest with identical args reached Link Up but
    #     never enumerated the GPU at all, then disconnected cleanly ~47s in with no
    #     timeout logged. No consistent improvement over host_reset=0 alone.
    #   - pcie_aspm=off + pcie_port_pm=off (stacked on the above): regressed further -
    #     dock never even reached PCIe hotplug (no pciehp/Card present/Link Up at all,
    #     2 attempts, both TB4 root ports), dying earlier at Thunderbolt retimer/tunnel
    #     negotiation ~11-12s after "new retimer found". Suspect PCIe port link-power-
    #     state management is required during Thunderbolt tunnel bring-up.
    # Getting 3 distinct failure signatures from runs with identical kernel args points
    # to genuine hardware-level flakiness on the dock's ASM2464 bridge, not something a
    # single kernel arg reliably fixes. Paused here - back to host_reset=0 only pending
    # further ideas. Do not re-add without a clear new hypothesis to test in isolation.
    # 2026-07-28: commented out to test whether the 595.71.05 open-gpu-kernel-modules
    # build actually still requires this for the RTX 3090 (Ampere) - driver release notes
    # for recent versions suggest broader consumer-card support may no longer need it.
    # - nvidia.NVreg_OpenRmEnableUnsupportedGpus=1 # Open kernel modules on consumer GeForce cards (RTX 3090/Ampere) have historically needed this to enable at all; harmless no-op if the driver no longer checks it

    # --- Intentionally left disabled ---
    # - elevator=mq-deadline              # Kernel auto-selects per device: none (NVMe), mq-deadline (SATA) — global override would harm NVMe
    # - nohz_full=4,5,6,7                # CPU tick isolation — marginal homelab benefit, complex to tune correctly
  systemExtensions:
    officialExtensions:
      - siderolabs/gasket-driver          # M.2 Google Coral accelerators
      - siderolabs/i915                   # Intel iGPU
      - siderolabs/intel-ucode            # Intel iGPU
      - siderolabs/mei                    # Intel Management Engine drivers
      - siderolabs/nfsrahead              # NFS Performance
      - siderolabs/nut-client             # Network UPS Tools
      {% if ENV.EGPU %}
      - siderolabs/nvidia-container-toolkit-production # eGPU (k8s-2 only) - exposes NVIDIA GPU to containers
      - siderolabs/nvidia-open-gpu-kernel-modules-production # eGPU (k8s-2 only) - RTX 3090 (Ampere); open kernel modules officially support Turing/Ampere/Ada/Blackwell, same extension works across the card swap
      {% endif %}
      - siderolabs/nvme-cli               # NVMe command line tools
      - siderolabs/thunderbolt             # USB4/TB4 PCIe tunneling (planned eGPU)
      - siderolabs/util-linux-tools       # Useful Linux tools
