---
# machine.type stays on the old v1alpha1 field (deprecated but functional) -
# `just talos machine-controller` reads it directly to resolve IS_CONTROLLER
# for the base template render, and no new 1.14 document kind carries it;
# KubeNodeConfig only covers labels. Matches onedr0p/home-ops's own pattern.
machine:
  type: controlplane
---
apiVersion: v1alpha1
kind: KubeNodeConfig
# KubeNodeConfig manages Node object labels declaratively - it enforces
# exactly this set, so node-role.kubernetes.io/control-plane must be
# listed explicitly or Talos strips it (confirmed live 2026-09-09:
# applying without it removed the label kubeadm had originally set,
# even though the old machine.nodeLabels field never listed it either -
# that field only ever added labels, it never took ownership of the
# full set the way this new controller does). Matches onedr0p's pattern.
labels:
  topology.kubernetes.io/zone: dmf-u
  node-role.kubernetes.io/control-plane: ""
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/installer/c48c7cd95afa9ff46bf74268bd4dd7b47f9c0ed3a658162b7916edb0b0c78630:v1.14.0 # baseline, net.ifnames=0 removed - see `just talos gen-schematic-id`
provisioning:
  diskSelector:
    match: disk.model == "Samsung SSD 870"
  wipe: false
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: k8s-1
