---
machine:
  type: controlplane
  nodeLabels:
    topology.kubernetes.io/zone: dmf-u
  install:
    diskSelector:
      model: Samsung SSD 870
    # 2026-07-25: RTX 3090 arrived, tested in the AOOSTAR AG02 dock (ASMedia ASM2464
    # bridge) - never stable, every attempt failed within 9-47s (pciehp hotplug command
    # 0x1038 timeout or earlier). thunderbolt.host_reset=0 was the only kernel arg that
    # helped at all; pci=realloc,assign-busses/pcie_aspm=off/pcie_port_pm=off all made it
    # worse and were reverted the same day. See schematic.yaml.j2 for full history.
    # 2026-07-28: swapped to a PELADN Link S-3 dock (Intel Barlow Ridge JHL9480 TB5
    # controller, not ASMedia) - RTX 3090 enumerated cleanly and held the link with zero
    # disconnects, already far more stable than any AG02 attempt. Switching to the eGPU
    # schematic (NVIDIA driver extensions) now that the link itself is confirmed solid.
    image: factory.talos.dev/installer/82d9f23333d2b1b96f49b3a0bc2369965dc557bb989aeb1d2360fb54afddf9c2:v1.13.7 # eGPU schematic (thunderbolt.host_reset=0 + nvidia extensions) - see `just talos gen-schematic-id-egpu`
    wipe: false
  kernel:
    modules:
      # The RTX 3090 is behind a Thunderbolt-hotplugged dock, so it isn't present on the
      # PCI bus until well after early boot's udev coldplug/modalias-autoload pass has
      # already run - the nvidia.ko module's normal autoload trigger never fires, and
      # ext-nvidia-persistenced hangs forever waiting on /sys/bus/pci/drivers/nvidia to
      # exist (2026-07-28, first eGPU-schematic boot). Force-loading it here unconditionally
      # means the PCI core will bind it automatically once the GPU actually appears,
      # regardless of when the Thunderbolt tunnel comes up.
      - name: nvidia
      - name: nvidia_uvm
      - name: nvidia_modeset
      - name: nvidia_drm
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: k8s-2
